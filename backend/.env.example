# Local development defaults only; use secure managed configuration in deployment.
DATABASE_URL=postgresql+psycopg://trackonomics:trackonomics_local@127.0.0.1:5432/trackonomics
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver","api"]
MAX_REQUEST_BYTES=8192
# Live ingestion is OFF; supply a 32+ character random token securely to enable it.
INGESTION_ENABLED=false
INGESTION_TOKEN=
MUSICBRAINZ_USER_AGENT=
MUSICBRAINZ_MAX_RELEASES=20

# Configure these securely on the API server; never in NEXT_PUBLIC_ variables.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MARKET=ZA
SPOTIFY_MAX_ALBUMS=5
SPOTIFY_MAX_TRACKS_PER_ALBUM=50

# Durable bulk imports run inside the API; no separate queue service is required.
BULK_WORKER_ENABLED=true
BULK_POLL_SECONDS=2
